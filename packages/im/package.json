{
  "name": "@collagejs/vite-im",
  "version": "0.1.0",
  "description": "Vite plug-in that injects an import map and @collagejs/imo to the project's HTML page",
  "keywords": [
    "importmap",
    "vite",
    "vite-plugin",
    "micro-frontend",
    "collagejs",
    "mfe"
  ],
  "homepage": "https://collagejs.dev",
  "bugs": {
    "url": "https://github.com/collagejs/vite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/collagejs/vite.git"
  },
  "license": "MIT",
  "author": {
    "name": "José Pablo Ramírez Vargas",
    "email": "webJose@gmail.com"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc && publint",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "publint": "^0.3.16",
    "rimraf": "^6.1.2",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@collagejs/imo": "0.x || 1.x",
    "@collagejs/vite-aim": "0.x || 1.x",
    "wj-config": "^4.0.0-beta.0 || ^4"
  }
}
