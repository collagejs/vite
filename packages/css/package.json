{
  "name": "@collagejs/vite-css",
  "version": "0.8.0",
  "description": "Vite plug-in for automatic CSS injection in CollageJS micro-frontends",
  "keywords": [
    "micro-frontend",
    "mfe",
    "microfrontend",
    "collagejs",
    "vite",
    "vite-plugin",
    "css"
  ],
  "homepage": "https://collagejs.dev",
  "bugs": {
    "url": "https://github.com/collagejs/vite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/collagejs/vite.git"
  },
  "license": "MIT",
  "author": {
    "name": "José Pablo Ramírez Vargas",
    "email": "webJose@gmail.com"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ex": {
      "types": "./dist/index-ex.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/index-ex.js*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc && publint",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": "^8.1.0"
  },
  "dependencies": {
    "@collagejs/core": "0.x || 1.x",
    "@collagejs/vite-aim": "0.6.0",
    "wj-config": "^4.0.0-beta.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "publint": "^0.3.16",
    "rimraf": "^6.1.2",
    "vitest": "^4.1.9"
  }
}
