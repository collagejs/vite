{
  "name": "@collagejs/vite-aim",
  "version": "0.6.0",
  "description": "Vite plug-in that automatically externalizes anything specified in the application's import map",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/index-im.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./im": {
      "types": "./dist/index-im.d.ts"
    }
  },
  "scripts": {
    "build": "vite build && publint",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "vite",
    "plugin",
    "typescript",
    "import-maps",
    "externalize",
    "collagejs"
  ],
  "author": {
    "name": "José Pablo Ramírez Vargas",
    "email": "webJose@gmail.com"
  },
  "homepage": "https://collagejs.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/collagejs/vite.git"
  },
  "bugs": {
    "url": "https://github.com/collagejs/vite/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@collagejs/shared": "*",
    "@microsoft/api-extractor": "^7.58.9",
    "publint": "^0.3.16",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@collagejs/importmap": "^0.2.0",
    "@wjfe/async-workers": "^0.2.4",
    "picocolors": "^1.1.1"
  }
}
